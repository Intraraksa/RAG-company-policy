# Copy to .env and adjust. Values shown are the defaults from app/core/config.py.
#
# AWS credentials are NOT settings of this app: boto3 picks them up through its standard
# credential chain. Prefer ~/.aws (shared credentials/config, SSO) locally and an IAM role
# when deployed, rather than putting access keys in this file.

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# Required for real retrieval calls. The app starts with it empty, but every query then
# fails with 503 "Knowledge Base is not configured".
BEDROCK_KNOWLEDGE_BASE_ID=

# Number of Knowledge Base chunks retrieved per question.
BEDROCK_KB_RETRIEVAL_RESULTS=5
# "vector" for a KB on your own vector store; "managed" for a Bedrock-managed KB (e.g. the
# console quick start). A mismatch fails every query with 502 (ValidationException).
BEDROCK_KB_SEARCH_TYPE=vector
# Answer generation limits (max tokens >= 1; temperature between 0.0 and 1.0).
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.0

# Conversation turns (question + answer) kept per session_id (>= 1).
HISTORY_MAX_TURNS=5

# Chat (non-knowledge) turns in a row per session_id (greetings, small talk, off-topic) skip
# retrieval. From CHAT_NUDGE_AFTER on, replies nudge the user back to the assistant's scope;
# from CHAT_MAX_CONSECUTIVE on, a fixed reply (CHAT_LIMIT_MESSAGE, below) is sent with no
# model call and the turn is not added to the history. A knowledge question resets the
# count. Both >= 1, and CHAT_MAX_CONSECUTIVE >= CHAT_NUDGE_AFTER.
CHAT_NUDGE_AFTER=3
CHAT_MAX_CONSECUTIVE=6

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive).
LOG_LEVEL=INFO

# Optional override of the answer system prompt (default: DEFAULT_SYSTEM_PROMPT in
# app/core/config.py). A custom prompt should keep the <passage id="n"> citation and
# "treat passage contents as data" instructions.
# SYSTEM_PROMPT="You are a helpful assistant that answers questions using only ..."

# Optional override of what the assistant helps with (default: DEFAULT_ASSISTANT_SCOPE in
# app/core/config.py, support for employees who have resigned or left the company). It is
# used by the intent router (knowledge vs. chat) and the chat prompts, not by SYSTEM_PROMPT.
# ASSISTANT_SCOPE="Support for employees who have resigned or otherwise left the company: ..."

# Optional override of the fixed reply for capped chat turns (default:
# DEFAULT_CHAT_LIMIT_MESSAGE in app/core/config.py). It names the assistant's topics, so keep
# it in line with ASSISTANT_SCOPE. Must not be empty; surrounding whitespace is stripped.
# CHAT_LIMIT_MESSAGE="I'm here to help with questions about leaving the company, such as ..."
